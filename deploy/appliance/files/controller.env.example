# This file belongs at /etc/certistack/secrets/controller.env with mode 0600.
# Keep it on the controller appliance; do not copy it to PVE nodes.
PVE_URL=https://pve.example.internal:8006
PVE_TOKEN_ID=certistack-svc@pve!automation
PVE_TOKEN_SECRET=replace-with-a-pve-token-secret
PBS_REPOSITORY=certistack@pbs!read@pbs.example.internal:8007:datastore
PBS_PASSWORD=replace-with-a-pbs-read-token-secret
# A default PBS certificate is self-signed, so a stock PBS needs this line:
# uncomment it and write the certificate's SHA-256 fingerprint exactly as the PBS
# dashboard shows it (Dashboard, Show Fingerprint), or as `proxmox-backup-manager
# cert info` prints it on the PBS: 32 hex pairs separated by colons, aa:bb:cc:...
# Without it, a run against such a PBS stops with "PBS_FINGERPRINT is not set and
# no CA the node trusts signed the certificate". The line stays commented out
# here because the example value is not a real fingerprint: PBS would refuse it.
#PBS_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
# A stock Proxmox VE node signs its API certificate with the cluster's own CA,
# which the container does not trust, so install that CA in almost every setup:
# copy /etc/pve/pve-root-ca.pem from the node to pve-ca.pem next to this file and
# uncomment the line. While it is active, a missing file stops every run before
# the transfer.
#CERTISTACK_PVE_CA_SOURCE=/run/certistack-secrets/pve-ca.pem
CERTISTACK_NODE=pve-01
CERTISTACK_SSH_HOST=pve-01.example.internal
CERTISTACK_SSH_USER=certistack
CERTISTACK_SSH_PORT=22
CERTISTACK_SSH_IDENTITY=/run/certistack-secrets/id_ed25519
CERTISTACK_SSH_KNOWN_HOSTS=/run/certistack-secrets/known_hosts
CERTISTACK_SSH_SUDO=true
