#!/bin/sh
# CertiStack access setup. Review it, then run each part where it says.
# Generated by: certistack setup rbac --node pve-node-01 --overlay-storage certistack-scratch --pbs-datastore datastore1 --part pve
#
# `certistack setup rbac` printed this script and ran nothing. certistack never
# sees the secrets the script creates: each token secret is printed once, by the
# command that creates it, on the terminal where you run it. Put it in your 0600
# controller.env at once; neither PVE nor PBS can show it again.
#
# The script is safe to run again, after an error or when a newer CertiStack
# prints it: a role that exists is set to the current privilege list, a user or
# token that exists is left as it is (a token's secret cannot be shown a second
# time, so the script says how to replace it instead), and the ACLs are set again.
# A token that exists gets the ACLs only if you hold its secret: then run the
# script with CERTISTACK_KEEP_TOKEN=yes in front. Without it the script stops
# before any grant, so a token made for another controller gains no access.
# If a step fails the script stops and says which one; run it again once the
# cause is fixed.
#
# This file holds PART 1 only, for a Proxmox VE node: run it as root there. PART 2,
# for the Proxmox Backup Server, is printed by the same command with --part pbs:
#   certistack setup rbac --node pve-node-01 --overlay-storage certistack-scratch --pbs-datastore datastore1 --part pbs | ssh root@PBS-HOST sh -s

# ======================================================================
# PART 1 of 2: Proxmox VE. Run as root on a PVE node. pveum configures the
# whole cluster, so any one node will do.
# ======================================================================
set -eu
command -v pveum >/dev/null 2>&1 || { echo "pveum not found: run PART 1 as root on a Proxmox VE node" >&2; exit 1; }
STEP='starting'
trap 'status=$?; [ "$status" -eq 0 ] || echo "certistack access setup stopped while $STEP (exit status $status). Nothing after this step ran. Fix the cause shown above, then run the script again: every step can be repeated." >&2' EXIT

# 1. The role: the privileges a run needs and nothing else. It is the list in
#    terraform/main.tf and at https://certistack.dev/docs/manual-setup/. A role that
#    exists is set to this list; a missing one is created.
STEP='creating or updating the role CertiStackRole'
if pveum role list --output-format json | grep -Fq '"CertiStackRole"'; then
  pveum role modify CertiStackRole --privs "VM.Allocate VM.Audit VM.PowerMgmt VM.Console VM.Config.Disk VM.Config.CPU VM.Config.Memory VM.Config.Network VM.Config.Options VM.Config.HWType VM.Config.CDROM SDN.Allocate SDN.Audit SDN.Use Sys.Audit Datastore.AllocateSpace Datastore.Audit"
  echo 'Role CertiStackRole existed: its privileges are now the current list.'
else
  pveum role add CertiStackRole --privs "VM.Allocate VM.Audit VM.PowerMgmt VM.Console VM.Config.Disk VM.Config.CPU VM.Config.Memory VM.Config.Network VM.Config.Options VM.Config.HWType VM.Config.CDROM SDN.Allocate SDN.Audit SDN.Use Sys.Audit Datastore.AllocateSpace Datastore.Audit"
  echo 'Role CertiStackRole created.'
fi

# 2. The service user. It has no password, so nobody can sign in as it. A user
#    that exists is left as it is.
STEP='creating the user certistack-svc@pve'
if pveum user list --output-format json | grep -Fq '"certistack-svc@pve"'; then
  echo 'Found the existing user certistack-svc@pve. It was not examined or changed: it is left as it is, whatever its state (a disabled user stays disabled).'
else
  pveum user add certistack-svc@pve --comment "CertiStack restore tests"
  echo 'User certistack-svc@pve created.'
fi

# 3. The API token, privilege-separated: PVE gives it only the privileges that
#    both it and its user hold on a path, which is why item 4 grants both.
#    PVE prints the token's secret ("value") ONCE, here. It is PVE_TOKEN_SECRET.
#    PVE_TOKEN_ID is certistack-svc@pve!automation.
#    A token that exists is not created again (PVE cannot show its secret a second
#    time); the ACLs below are given to it only if its secret is held.
STEP='creating the API token certistack-svc@pve!automation'
if pveum user token list certistack-svc@pve --output-format json | grep -Eq '"(certistack-svc@pve!)?automation"'; then
  echo 'Found the existing API token certistack-svc@pve!automation: it exists already, so it was not created again.' >&2
  echo 'It was not examined or changed: its expiry, its privilege separation and its comment stay as they are.' >&2
  echo 'A token made by hand without --privsep 1 holds all the privileges of its user, not only the role; if it was, replace it as below.' >&2
  echo 'PVE shows the secret of a token only once, when it is created; it cannot be shown again.' >&2
  if [ "${CERTISTACK_KEEP_TOKEN:-}" != yes ]; then
    echo 'Nothing was granted to it: a token whose secret is held elsewhere gains no access from this script.' >&2
    echo 'If you hold its secret (your PVE_TOKEN_SECRET), run this script again with CERTISTACK_KEEP_TOKEN=yes in front, for example: CERTISTACK_KEEP_TOKEN=yes sh -s < this-script.sh' >&2
    echo 'If you lost it, replace the token: run  pveum user token remove certistack-svc@pve automation' >&2
    echo 'and then run this script again; it creates a new token and prints its new secret.' >&2
    exit 3
  fi
  echo 'CERTISTACK_KEEP_TOKEN=yes: you hold its secret, so the grants below are given to it.' >&2
else
  echo 'Creating the API token certistack-svc@pve!automation. Its secret is printed once, below: copy it now.'
  pveum user token add certistack-svc@pve automation --privsep 1
fi

# 4. Grant the role to the user AND to the token on each path below, and on no
#    other: never on "/".
STEP='granting CertiStackRole on the paths of item 4'
# /vms: the sandbox VMs (/vms/<vmid>); not narrower, because PVE deletes a VM's own ACL when the VM is destroyed.
pveum acl modify /vms --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /sdn: taking PVE's SDN lock (PVE 9) and applying the sandbox network.
pveum acl modify /sdn --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 0
# /sdn/zones: creating and removing the ephemeral sandbox zone and its VNet.
pveum acl modify /sdn/zones --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /storage/certistack-scratch: the overlays and firmware copies.
pveum acl modify /storage/certistack-scratch --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /nodes/pve-node-01: reading the node's status and QEMU machine versions.
pveum acl modify /nodes/pve-node-01 --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 0

# 5. Check what the token holds on a path (certistack plan lists any privilege
#    still missing for the paths a plan uses):
STEP='reading the token permissions'
pveum user token permissions certistack-svc@pve automation --path /vms

# Then, on the controller, in controller.env:
#   PVE_TOKEN_ID=certistack-svc@pve!automation
#   PVE_TOKEN_SECRET=<the value item 3 printed>
