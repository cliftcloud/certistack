#!/bin/sh
# CertiStack access setup. Review it, then run each part where it says.
# Generated by: certistack setup rbac --node pve-node-01 --overlay-storage certistack-scratch --sandbox-zones csSb01,csSb02 --pbs-datastore datastore1 --pbs-namespace prod
#
# `certistack setup rbac` printed this script and ran nothing. certistack never
# sees the secrets the script creates: each token secret is printed once, by the
# command that creates it, on the terminal where you run it. Put it in your 0600
# controller.env at once; neither PVE nor PBS can show it again.
#
# The script is safe to run again, after an error or when a newer CertiStack
# prints it: a role that exists is set to the current privilege list, a user or
# token that exists is left as it is (a token's secret cannot be shown a second
# time, so the script says how to replace it instead), and the ACLs are set again.
# If a step fails the script stops and says which one; run it again once the
# cause is fixed.
#
# This file holds two parts for two hosts. Copy PART 1 to a Proxmox VE node and
# PART 2 to the Proxmox Backup Server, and run each as root on its own host.
# To send one part to its host without copying this file, print it alone:
#   certistack setup rbac --node pve-node-01 --overlay-storage certistack-scratch --sandbox-zones csSb01,csSb02 --pbs-datastore datastore1 --pbs-namespace prod --part pve | ssh root@NODE sh -s
#   certistack setup rbac --node pve-node-01 --overlay-storage certistack-scratch --sandbox-zones csSb01,csSb02 --pbs-datastore datastore1 --pbs-namespace prod --part pbs | ssh root@PBS-HOST sh -s

# ======================================================================
# PART 1 of 2: Proxmox VE. Run as root on a PVE node. pveum configures the
# whole cluster, so any one node will do.
# ======================================================================
set -eu
command -v pveum >/dev/null 2>&1 || { echo "pveum not found: run PART 1 as root on a Proxmox VE node" >&2; exit 1; }
STEP='starting'
trap 'status=$?; [ "$status" -eq 0 ] || echo "certistack access setup stopped while $STEP (exit status $status). Nothing after this step ran. Fix the cause shown above, then run the script again: every step can be repeated." >&2' EXIT

# 1. The role: the privileges a run needs and nothing else. It is the list in
#    terraform/main.tf and at https://certistack.dev/docs/manual-setup/. A role that
#    exists is set to this list; a missing one is created.
STEP='creating or updating the role CertiStackRole'
if pveum role list --output-format json | grep -Fq '"CertiStackRole"'; then
  pveum role modify CertiStackRole --privs "VM.Allocate VM.Audit VM.PowerMgmt VM.Console VM.Config.Disk VM.Config.CPU VM.Config.Memory VM.Config.Network VM.Config.Options VM.Config.HWType VM.Config.CDROM SDN.Allocate SDN.Audit SDN.Use Sys.Audit Datastore.AllocateSpace Datastore.Audit"
  echo 'Role CertiStackRole existed: its privileges are now the current list.'
else
  pveum role add CertiStackRole --privs "VM.Allocate VM.Audit VM.PowerMgmt VM.Console VM.Config.Disk VM.Config.CPU VM.Config.Memory VM.Config.Network VM.Config.Options VM.Config.HWType VM.Config.CDROM SDN.Allocate SDN.Audit SDN.Use Sys.Audit Datastore.AllocateSpace Datastore.Audit"
  echo 'Role CertiStackRole created.'
fi

# 2. The service user. It has no password, so nobody can sign in as it. A user
#    that exists is left as it is.
STEP='creating the user certistack-svc@pve'
if pveum user list --output-format json | grep -Fq '"certistack-svc@pve"'; then
  echo 'Found the existing user certistack-svc@pve. It was not examined or changed: it is left as it is, whatever its state (a disabled user stays disabled).'
else
  pveum user add certistack-svc@pve --comment "CertiStack DR validation"
  echo 'User certistack-svc@pve created.'
fi

# 3. The API token, privilege-separated: PVE gives it only the privileges that
#    both it and its user hold on a path, which is why item 4 grants both.
#    PVE prints the token's secret ("value") ONCE, here. It is PVE_TOKEN_SECRET.
#    PVE_TOKEN_ID is certistack-svc@pve!automation.
#    A token that exists is not created again (PVE cannot show its secret a second
#    time); the script says how to replace it and goes on with the ACLs.
STEP='creating the API token certistack-svc@pve!automation'
if pveum user token list certistack-svc@pve --output-format json | grep -Eq '"(certistack-svc@pve!)?automation"'; then
  echo 'Found the existing API token certistack-svc@pve!automation: it exists already, so it was not created again.' >&2
  echo 'It was not examined or changed: its expiry, its privilege separation and its comment stay as they are.' >&2
  echo 'A token made by hand without --privsep 1 holds all the privileges of its user, not only the role; if it was, replace it as below.' >&2
  echo 'PVE shows the secret of a token only once, when it is created; it cannot be shown again.' >&2
  echo 'If you still have that secret, it is your PVE_TOKEN_SECRET and nothing more is needed.' >&2
  echo 'If you lost it, replace the token: run  pveum user token remove certistack-svc@pve automation' >&2
  echo 'and then run this script again; it creates a new token and prints its new secret.' >&2
else
  echo 'Creating the API token certistack-svc@pve!automation. Its secret is printed once, below: copy it now.'
  pveum user token add certistack-svc@pve automation --privsep 1
fi

# 4. Grant the role to the user AND to the token on each path below, and on no
#    other: never on "/".
#    This is for pre-provisioned sandbox zone(s) csSb01, csSb02, so /sdn and /sdn/zones are
#    not granted. A plan with the default ephemeral sandbox would fail its
#    privilege check; leave --zone and --sandbox-zones out for that.
STEP='granting CertiStackRole on the paths of item 4'
# /vms: the sandbox VMs (/vms/<vmid>); not narrower, because PVE deletes a VM's own ACL when the VM is destroyed.
pveum acl modify /vms --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /sdn/zones/csSb01: reading and using the pre-provisioned sandbox zone csSb01 and its VNet.
pveum acl modify /sdn/zones/csSb01 --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /sdn/zones/csSb02: reading and using the pre-provisioned sandbox zone csSb02 and its VNet.
pveum acl modify /sdn/zones/csSb02 --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /storage/certistack-scratch: the overlays and firmware copies.
pveum acl modify /storage/certistack-scratch --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 1
# /nodes/pve-node-01: reading the node's status and QEMU machine versions.
pveum acl modify /nodes/pve-node-01 --roles CertiStackRole --users certistack-svc@pve --tokens 'certistack-svc@pve!automation' --propagate 0

# 5. Check what the token holds on a path (certistack plan lists any privilege
#    still missing for the paths a plan uses):
STEP='reading the token permissions'
pveum user token permissions certistack-svc@pve automation --path /vms

# Then, on the controller, in controller.env:
#   PVE_TOKEN_ID=certistack-svc@pve!automation
#   PVE_TOKEN_SECRET=<the value item 3 printed>

# ======================================================================
# PART 2 of 2: Proxmox Backup Server. Run as root on the PBS server.
# ======================================================================
set -eu
STEP='checking that this host is the Proxmox Backup Server'
if ! command -v proxmox-backup-manager >/dev/null 2>&1; then
  if command -v pveum >/dev/null 2>&1; then
    echo 'Part 1 is done on this Proxmox VE node. Part 2 is for the Proxmox Backup Server and is not run here:'
    echo 'run part 2 on the Proxmox Backup Server, as root there, with this file or with the same certistack setup rbac command plus --part pbs.'
    exit 0
  fi
  echo "proxmox-backup-manager not found: run PART 2 as root on the Proxmox Backup Server" >&2
  exit 1
fi
STEP='starting'
trap 'status=$?; [ "$status" -eq 0 ] || echo "certistack access setup stopped while $STEP (exit status $status). Nothing after this step ran. Fix the cause shown above, then run the script again: every step can be repeated." >&2' EXIT

# A read-only identity: DatastoreReader (Datastore.Audit and Datastore.Read) on
# the namespace prod of the datastore datastore1 only and no write privilege. A user that exists is left as it is.
# This script adds that grant and removes none: a wider grant the user already
# holds stays. Check what it holds with: proxmox-backup-manager acl list
STEP='creating the PBS user certistack-ro@pbs'
if proxmox-backup-manager user list --output-format json | grep -Fq '"certistack-ro@pbs"'; then
  echo 'Found the existing PBS user certistack-ro@pbs. It was not examined or changed: it is left as it is, whatever its state (a disabled user stays disabled).'
else
  proxmox-backup-manager user create certistack-ro@pbs
  echo 'PBS user certistack-ro@pbs created.'
fi

# generate-token prints the token's secret ONCE. It is PBS_PASSWORD. A token that
# exists is not created again (PBS cannot show its secret a second time); the
# script says how to replace it and goes on with the ACLs.
STEP='creating the PBS API token certistack-ro@pbs!ro'
if proxmox-backup-manager user list-tokens certistack-ro@pbs --output-format json | grep -Eq '"(certistack-ro@pbs!)?ro"'; then
  echo 'Found the existing PBS API token certistack-ro@pbs!ro: it exists already, so it was not created again.' >&2
  echo 'It was not examined or changed: its expiry, its privilege separation and its comment stay as they are.' >&2
  echo 'PBS shows the secret of a token only once, when it is created; it cannot be shown again.' >&2
  echo 'If you still have that secret, it is your PBS_PASSWORD and nothing more is needed.' >&2
  echo 'If you lost it, replace the token: run  proxmox-backup-manager user delete-token certistack-ro@pbs ro (or in the PBS web UI: Configuration, Access Control, API Token)' >&2
  echo 'and then run this script again; it creates a new token and prints its new secret.' >&2
else
  echo 'Creating the PBS API token certistack-ro@pbs!ro. Its secret is printed once, below: copy it now.'
  proxmox-backup-manager user generate-token certistack-ro@pbs ro
fi

# The role is set for the user and for the token, so the token is covered
# whichever of the two PBS consults.
STEP='granting DatastoreReader on /datastore/datastore1/prod'
proxmox-backup-manager acl update /datastore/datastore1/prod DatastoreReader --auth-id certistack-ro@pbs
proxmox-backup-manager acl update /datastore/datastore1/prod DatastoreReader --auth-id 'certistack-ro@pbs!ro'

# An earlier grant on the whole datastore (/datastore/datastore1, from a setup or a script
# without a namespace) is not taken back by the namespace grant above, and
# lets the user read every namespace. Look for it; this changes nothing.
STEP='looking for an earlier grant on /datastore/datastore1'
wider=$(proxmox-backup-manager acl list --output-format json 2>/dev/null | tr -d '\n' | grep -o '{[^}]*}' | grep -F '"path":"/datastore/datastore1"' | grep -F '"roleid":"DatastoreReader"' | grep -F '"propagate":true' || true)
held=
case "$wider" in *'"ugid":"certistack-ro@pbs"'*) held='certistack-ro@pbs' ;; esac
case "$wider" in *'"ugid":"certistack-ro@pbs!ro"'*) held="$held "'certistack-ro@pbs!ro' ;; esac
if [ -n "$held" ]; then
  echo 'The PBS user can still read every namespace of the datastore datastore1: an earlier grant on /datastore/datastore1 stays, and this script removes none. To remove it, run:'
  for id in $held; do
    echo "  proxmox-backup-manager acl update /datastore/datastore1 DatastoreReader --auth-id '$id' --delete true"
  done
fi

# Then, on the controller, in controller.env:
#   PBS_REPOSITORY=certistack-ro@pbs!ro@<PBS host>:8007:datastore1
#   PBS_PASSWORD=<the secret generate-token printed>
#   PBS_FINGERPRINT=<the PBS certificate's fingerprint: proxmox-backup-manager cert info>
#   PBS_NAMESPACE=prod
